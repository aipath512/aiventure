  "autonomy": {
    "model": "L1-L5",
    "levels": [
      {
        "id": "L1",
        "name": "DISCOVER",
        "can": [
          "find_service",
          "identify_provider",
          "explain_public_offer",
          "show_public_area_and_conditions"
        ],
