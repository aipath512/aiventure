          "compare_providers",
          "compare_outcomes",
          "compare_prices",
          "compare_terms",
          "compare_territories",
          "compare_conditions",
          "compare_evidence"
        ]
      },
      {
        "id": "L3",
        "name": "REQUEST",
        "can": [
          "check_eligibility",
          "ask_qualification_questions",
          "collect_brief",
          "create_request",
          "send_lead_to_crm",
          "confirm_next_step"
        ],
        "escalate_on": [
          "ambiguity",
          "sensitive_case"
        ]
      },
      {
        "id": "L4",
        "name": "QUOTE",
        "can": [
          "identify_package",
          "calculate_within_parameters",
          "generate_quote_draft",
          "estimate_delivery_time",
          "propose_next_step"
        ],
        "requires_human_approval_for": [
          "discount",
          "final_offer",
          "exceptions",
          "special_terms",
          "special_commercial_conditions"
        ]
      },
      {
        "id": "L5",
        "name": "ORDER",
        "can": [
          "initiate_order"
        ],
        "conditions": [
          "standardized_service",
          "stable_price",
          "published_terms",
          "available_capacity",
          "authorized_autonomy"
        ]
      }
    ],
    "rules": [
      "Fără regulă explicită → fără autonomie.",
      "Fără jurisdicție identificată → fără acțiune sensibilă.",
      "Fără aprobare unde este necesară → fără angajament comercial.",
      "Fără Evidence → fără dovada deciziei."
    ]
  },

